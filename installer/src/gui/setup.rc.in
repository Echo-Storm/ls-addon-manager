#include <windows.h>

1 ICON "@SETUP_ICON@"
#if @SETUP_HAS_PAYLOAD@
101 RCDATA "@SETUP_PAYLOAD_RC@"
#endif

// ProductName "LS Addon Manager Setup" and ProductVersion (the release's number) are checked by every released manager's updater from 0.9.7
// on before it runs a downloaded Setup (manager/src/update/updater.cpp): keep that name, or no one can update to this release from inside.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @SETUP_VERSION_CSV@
 PRODUCTVERSION @SETUP_VERSION_CSV@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Echo-Storm"
            VALUE "FileDescription", "LS Addon Manager Setup"
            VALUE "FileVersion", "@SETUP_VERSION@"
            VALUE "InternalName", "LSAddonManagerSetup"
            VALUE "OriginalFilename", "LSAddonManagerSetup.exe"
            VALUE "ProductName", "LS Addon Manager Setup"
            VALUE "ProductVersion", "@SETUP_VERSION@"
            VALUE "LegalCopyright", "MIT licence"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
