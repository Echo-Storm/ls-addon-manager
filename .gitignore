# build output and release packages
build/
build_fg/
out/
dist/
*.obj
*.pdb
*.ilk
*.exp
*.lib
*.dll
*.exe
*.zip
*.log
*.map

# IDE and local CMake state
.vs/
.vscode/
.idea/
CMakeUserPresets.json
CMakeSettings.json

# renders and test dumps
*.bmp
*.bin
captures/
__pycache__/

# NVIDIA's DLSS SDK is not redistributable: download it yourself (addons/DLSS5NR01/external/ngx/README.md)
addons/DLSS5NR01/external/ngx/*
!addons/DLSS5NR01/external/ngx/README.md
# anything else dropped into external/ (SDK drops, snippets) stays out of the repo
addons/DLSS5NR01/external/*
!addons/DLSS5NR01/external/ngx/
# the lab tools' SDK drops (research only, never shipped): only the notes about them are in git
!addons/DLSS5NR01/external/streamline/
addons/DLSS5NR01/external/streamline/*
!addons/DLSS5NR01/external/streamline/README.md
!addons/DLSS5NR01/external/nvof/
addons/DLSS5NR01/external/nvof/*
!addons/DLSS5NR01/external/nvof/README.md
build_setup/
imgui.ini

# the tools' own Python environment (tools\depth_maps.py)
tools/.venv/

# dev.py: results, run logs, pictures
.dev/

# local test recordings (large): see recordings/README.md
recordings/*
!recordings/README.md

# scratch folders made by tests and evaluations
tmp_*/

# Lossless Scaling research (never published; kept outside the repository, these only guard against a copy landing here)
ls-research-private/
decomp/
*.lsdecomp
